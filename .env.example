# local-decision-model configuration, read by every scripts\*.ps1.
# Sections: shared (downloads/proxy), Rune (the default model), Laya (optional).

# ---------------------------------------------------------------------------------------------
# Shared: Hugging Face cache and the corporate proxy
# ---------------------------------------------------------------------------------------------
# Hugging Face cache lives inside the project. Relative paths are resolved against the project root.
HF_HOME=state\hf
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# hf_xet (Rust) has its own TLS stack and ignores the Umbrella CA bundle; download via Python instead.
HF_HUB_DISABLE_XET=1
# Weights are fetched once by scripts\fetch-rune.ps1 / fetch-laya.ps1 (which clear this); the
# servers never need the proxy.
HF_HUB_OFFLINE=1

# Corporate TLS inspection (Cisco Umbrella) on huggingface.co. Built by scripts\setup-tls.ps1.
SSL_CERT_FILE=state\certs\ca-bundle.pem
REQUESTS_CA_BUNDLE=state\certs\ca-bundle.pem
LOCAL_TLS_RELAX_STRICT=1

# ---------------------------------------------------------------------------------------------
# Rune 26B-A4B v3 (Invergent, Apache 2.0) -- the default model.
# llama.cpp llama-server's /v1/systemone (scripts\serve-rune.ps1, task RuneServe). Weights:
# scripts\fetch-rune.ps1 (owao's systemone-patched GGUFs). RUNE_GGUF is a file name in the HF
# cache, or a path. llama.cpp: scripts\setup-llama.ps1 (release pinned in LLAMA_CPP_RELEASE).
# Only the Vulkan build sees the 8060S here; the official win-rocm zip lists no devices with this
# driver. Use Q8_0: BF16 hits Vulkan ErrorDeviceLost on this driver.
# ---------------------------------------------------------------------------------------------
RUNE_HOST=127.0.0.1
RUNE_PORT=8001
RUNE_GGUF=Rune-26B-A4B-v3-Q8_0.gguf
RUNE_LLAMA_BACKEND=vulkan
RUNE_CTX=16384
RUNE_PARALLEL=1
# Prometheus /metrics for monitoring (Datadog OpenMetrics check; see docs\IT-HANDOFF.md). Behind RUNE_API_KEY when set.
RUNE_METRICS=1
# RUNE_API_KEY=
# RUNE_UBATCH=512            # llama-server -ub; lower it only to work around Vulkan device-lost

# ---------------------------------------------------------------------------------------------
# Laya (Convai Innovations) -- optional. Faster, but less accurate than Rune on our benchmark.
# laya-serve (scripts\serve-laya.ps1, task LayaServe). See laya/serve.py's docstring for every
# variable. Ignored unless you set Laya up (README, "Optional: Laya").
# ---------------------------------------------------------------------------------------------
# Bind to localhost only. To expose on the LAN, set 0.0.0.0, LAYA_API_KEY and a firewall rule.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# Memory profile: plenty of headroom (128 GB, 96 GB GPU carve-out), so keep every checkpoint resident.
LAYA_PRELOAD=1
LAYA_MODELS=english,typed-decisions,multilingual
LAYA_MAX_LOADED=3
LAYA_IDLE_UNLOAD_SECONDS=0
LAYA_DEFAULT_MODEL=english

# Pin checkpoints to the SHAs reviewed by the installed laya release (laya/revisions.py).
LAYA_REVISION=reviewed

# Device. Default: the Radeon 8060S via AMD's ROCm torch in .venv-rocm (scripts\setup-rocm.ps1);
# torch calls it "cuda". ~245 ms/email on our benchmark vs ~2.4 s on CPU. CPU fallback: comment out
# LAYA_VENV and set LAYA_DEVICE=cpu (uses .venv after `uv sync --extra laya`). LAYA_THREADS caps
# CPU threads; keep <= physical cores (16).
LAYA_VENV=.venv-rocm
LAYA_DEVICE=cuda
LAYA_THREADS=16
LAYA_MAX_CONCURRENT=16
LAYA_LOG_LEVEL=info

# LAYA_API_KEY=
